{
  "name": "@human-harness/dsh-control-plane",
  "version": "0.1.0",
  "description": "Нативная связь Human Harness с Control Plane: клиент API, Session харнесса, «Важное», проактивность по событиям ядра, инструменты модели и маршруты для UI (ctx.controlPlane)",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./shared": {
      "types": "./lib/types/shared/index.d.ts",
      "default": "./lib/types/shared/index.js"
    },
    "./package.json": "./package.json",
    "./attention-rules.json": "./attention-rules.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/shared/**/*.js",
    "attention-rules.json",
    "attention-rules.schema.json"
  ],
  "scripts": {
    "bundle": "tsdown"
  },
  "license": "Apache-2.0",
  "private": true,
  "devDependencies": {
    "@human-harness/dsh-identity": "workspace:^"
  }
}
